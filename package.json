{
  "name": "dsh-sticker-hub",
  "version": "0.1.1",
  "type": "module",
  "description": "Sticker (meme) library for DeepSeek Harness: local tagging, semantic search, inline images, and a sticker-battle mode for QQ / IM channels.",
  "license": "MIT",
  "author": "dsh-sticker-hub contributors",
  "homepage": "https://github.com/lukcyspring/dsh-sticker-hub#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukcyspring/dsh-sticker-hub.git"
  },
  "bugs": {
    "url": "https://github.com/lukcyspring/dsh-sticker-hub/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "sticker",
    "meme",
    "qq",
    "im",
    "obsidian"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "bin": {
    "sticker-hub": "./bin/sticker-hub.mjs"
  },
  "files": [
    "index.js",
    "client.js",
    "bin/",
    "docs/",
    "cordis.patch.yml",
    "sources.yaml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=0.0.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
